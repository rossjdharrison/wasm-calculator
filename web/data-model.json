            "args": [
              {
                "op": "has",
                "args": [
                  "packages",
                  "towing"
                ]
              },
              1300,
              0
            ]
          },
          {
            "op": "if",
            "args": [
              {
                "op": "has",
                "args": [
                  "packages",
                  "panoramicRoof"
                ]
              },
              1600,
              0
            ]
          }
        ]
      }
