                "op": "field",
                "args": [
                  "engine"
                ]
              }
            ]
          },
          {
            "op": "lookup",
            "args": [
              "wheelRangeFactor",
              {
                "op": "field",
                "args": [
                  "wheels"
                ]
              }
            ]
          },
          {
            "op": "if",
            "args": [
              {
                "op": "eq",
                "args": [
