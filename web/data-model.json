          {
            "op": "lookup",
            "args": [
              "wheelsDelta",
              {
                "op": "field",
                "args": [
                  "wheels"
                ]
              }
            ]
          },
          {
            "op": "lookup",
            "args": [
              "colourDelta",
              {
                "op": "field",
