  "computed": [
    {
      "id": "packagesTotal",
      "label": "Packages total",
      "formula": {
        "op": "add",
        "args": [
          {
            "op": "if",
            "args": [
              {
                "op": "has",
                "args": [
                  "packages",
                  "winter"
                ]
              },
              800,
              0
            ]
          },
          {
            "op": "if",
            "args": [
              {
                "op": "has",
                "args": [
                  "packages",
                  "tech"
                ]
              },
              1500,
              0
            ]
          },
          {
            "op": "if",
            "args": [
              {
                "op": "has",
                "args": [
                  "packages",
                  "driverAssist"
                ]
              },
              1900,
              0
            ]
          },
          {
            "op": "if",
            "args": [
              {
                "op": "has",
                "args": [
                  "packages",
                  "premiumAudio"
                ]
