{
  "id": "vehicle-sale",
  "version": "2.0.0",
  "title": "Vehicle sale",
  "correlationPrefix": "VS",
  "phases": [
    { "id": "configure", "label": "Configure", "order": 1, "tint": "#7f9bb0" },
    { "id": "shipping", "label": "Shipping", "order": 2, "tint": "#6fa8c0" },
    { "id": "insurance", "label": "Insurance", "order": 3, "tint": "#8fb08a" },
    { "id": "financing", "label": "Financing", "order": 4, "tint": "#d8a24a" },
    { "id": "agree_sign", "label": "Agree & Sign", "order": 5, "tint": "#c9a24a" },
    { "id": "exchange_settlement", "label": "Settlement", "order": 6, "tint": "#74c2a2" },
    { "id": "fulfilment", "label": "Handover", "order": 7, "tint": "#b98cc9" }
  ],
  "labels": {
    "record": "order", "recordPlural": "orders", "recordTotal": "Order total",
    "emptyPrompt": "Configure a build to begin your order.",
    "lifecycleLabel": "Order lifecycle", "captureNoun": "build"
  },
  "types": {
    "Owned": { "specializes": ["state"] },
    "Possessed": { "specializes": ["state"] }
  },
  "models": [
    { "ref": "vehicles", "as": "shopping", "phase": "configure", "role": "product" },
    { "ref": "shipping", "as": "shipping", "phase": "shipping", "role": "logistics" },
    { "ref": "insurance", "as": "insurance", "phase": "insurance", "role": "addon" },
    { "ref": "financing", "as": "financing", "phase": "financing", "role": "finance" }
  ],
  "bindings": [
    {
      "id": "weight-to-shipping",
      "from": "shopping",
      "to": "shipping",
      "contract": {
        "provides": [
          { "as": "weight", "l0": "physical_quantity", "source": "output:weight" },
          { "as": "otr", "l0": "amount_of_money", "source": "output:otr" }
        ],
        "requires": [
          { "name": "vehicleWeight", "l0": "physical_quantity", "target": "field:vehicleWeight" },
          { "name": "vehicleValue", "l0": "amount_of_money", "target": "field:vehicleValue" }
        ]
      },
      "mapping": [
        { "to": "vehicleWeight", "from": { "op": "field", "args": ["weight"] } },
        { "to": "vehicleValue", "from": { "op": "field", "args": ["otr"] } }
      ]
    },
    {
      "id": "value-to-insurance",
      "from": "shopping",
      "to": "insurance",
      "contract": {
        "provides": [{ "as": "otr", "l0": "amount_of_money", "source": "output:otr" }],
        "requires": [{ "name": "vehicleValue", "l0": "amount_of_money", "target": "field:vehicleValue" }]
      },
      "mapping": [{ "to": "vehicleValue", "from": { "op": "field", "args": ["otr"] } }]
    },
    {
      "id": "price-to-financing",
      "from": "shopping",
      "to": "financing",
      "contract": {
        "provides": [
          { "as": "otr", "l0": "amount_of_money", "source": "output:otr" },
          { "as": "paymentMode", "source": "field:paymentMode" }
        ],
        "requires": [
          { "name": "price", "l0": "amount_of_money", "target": "field:price" },
          { "name": "mode", "target": "field:mode" }
        ]
      },
      "mapping": [
        { "to": "price", "from": { "op": "field", "args": ["otr"] } },
        { "to": "mode", "from": { "op": "field", "args": ["paymentMode"] } }
      ]
    }
  ],
  "process": {
    "steps": [
      { "id": "build", "phase": "configure", "kind": "capture", "model": "shopping", "produces": "class_of_physical_object", "commitLabel": "Request this build ▸" },
      { "id": "ship", "phase": "shipping", "kind": "capture-downstream", "model": "shipping", "label": "Shipping", "actionLabel": "Confirm shipping ▸" },
      { "id": "insure", "phase": "insurance", "kind": "capture-downstream", "model": "insurance", "label": "Insurance", "actionLabel": "Confirm cover ▸" },
      {
        "id": "finance",
        "phase": "financing",
        "kind": "capture-downstream",
        "model": "financing",
        "label": "Financing",
        "actionLabel": "Confirm financing ▸",
        "availableWhen": {
          "reads": [{ "as": "mode", "from": "shopping", "source": "field:paymentMode" }],
          "test": { "op": "gt", "args": [{ "op": "field", "args": ["mode"] }, 0] }
        }
      },
      { "id": "sign", "phase": "agree_sign", "kind": "ceremony", "activity": "agreement", "outcome": "sign", "meaning": "Signing assents to your configured build and the sale contract. Nothing is charged until settlement.", "prompt": "Type your name to assent to this build and the sale contract", "actionLabel": "Sign & agree ▸" },
      { "id": "settle", "phase": "exchange_settlement", "kind": "ceremony", "activity": "transfer_of_ownership", "outcome": "transfer_of_ownership", "meaning": "Settlement transfers ownership to you — paid in full, or drawn down through the financing plan you arranged.", "prompt": "Name the person settling the order", "actionLabel": "Confirm settlement ▸", "enters": [{ "individual": "shopping#spec", "category": "Owned", "role": "owner", "label": "Ownership" }] },
      { "id": "deliver", "phase": "fulfilment", "kind": "ceremony", "activity": "transfer_of_possession", "outcome": "transfer_of_possession", "meaning": "The vehicle is handed over (or shipped per your Shipping choice) and possession passes to the keeper.", "prompt": "Name the person receiving the vehicle", "actionLabel": "Confirm handover ▸", "enters": [{ "individual": "shopping#spec", "category": "Possessed", "role": "keeper", "label": "Possession" }] }
    ]
  }
}
