{
  "title": "Data model",
  "collections": [
    {
      "key": "settings", "kind": "singleton", "title": "Model", "titleText": "Model settings",
      "form": [
        { "widget": "typePick", "label": "This model is a…" }
      ]
    },
    {
      "key": "types", "kind": "map", "title": "Classes (HQDM)", "singular": "Class", "sub": "specializes",
      "add": { "prompt": "New class id:", "template": { "specializes": [] } },
      "form": [
        { "prop": "title", "label": "Label", "widget": "text" },
        { "prop": "specializes", "label": "Specialises", "widget": "parents", "source": "categories" }
      ]
    },
    {
      "key": "fields", "kind": "array", "title": "Fields", "singular": "Field",
      "itemLabel": "id", "sub": "type",
      "add": { "prompt": "New field id:", "into": "id", "template": { "type": "number" } },
      "form": [
        { "prop": "type", "label": "Type", "widget": "select", "options": ["number", "choice", "boolean", "multichoice"], "rerender": true },
        { "prop": "unit", "label": "Unit", "widget": "text", "when": { "prop": "type", "eq": "number" } },
        { "prop": "min", "label": "Min", "widget": "formula", "when": { "prop": "type", "eq": "number" } },
        { "prop": "max", "label": "Max", "widget": "formula", "when": { "prop": "type", "eq": "number" } },
        { "prop": "step", "label": "Step", "widget": "formula", "when": { "prop": "type", "eq": "number" } },
        { "prop": "default", "label": "Default", "widget": "default" },
        { "prop": "category", "label": "Category (HQDM)", "widget": "select", "source": "categories", "allowNone": true, "noAutoSelect": true },
        { "prop": "options", "widget": "optionList" }
      ]
    },
    {
      "key": "computed", "kind": "array", "title": "Computed", "singular": "Computed",
      "itemLabel": "id",
      "add": { "prompt": "New computed id:", "into": "id", "template": { "formula": 0 } },
      "form": [
        { "prop": "label", "label": "Label", "widget": "text" },
        { "prop": "formula", "label": "Formula", "widget": "formula", "multiline": true, "required": true },
        { "prop": "category", "label": "Category (HQDM)", "widget": "select", "source": "categories", "allowNone": true, "noAutoSelect": true }
      ]
    },
    {
      "key": "tables", "kind": "map", "title": "Tables", "singular": "Table", "sub": "kind",
      "add": { "prompt": "New table name:", "template": { "kind": "1d", "map": {} } },
      "form": [ { "widget": "grid" } ]
    },
    {
      "key": "validations", "kind": "array", "title": "Validations", "singular": "Validation",
      "itemLabel": "id", "sub": "severity",
      "add": { "template": { "id": "rule", "when": 0, "message": "", "severity": "warning" } },
      "form": [
        { "prop": "id", "label": "Id", "widget": "text" },
        { "prop": "when", "label": "When", "widget": "rule" },
        { "prop": "message", "label": "Message", "widget": "text", "clearEmpty": false },
        { "prop": "severity", "label": "Severity", "widget": "select", "options": ["info", "warning", "error"] },
        { "prop": "field", "label": "Field", "widget": "select", "source": "fields", "allowNone": true }
      ]
    },
    {
      "key": "effects", "kind": "array", "title": "Effects", "singular": "Effect",
      "itemLabel": "setField", "itemLabelPrefix": "→ ",
      "add": { "template": { "when": 0, "setField": "", "toValue": "" } },
      "form": [
        { "prop": "when", "label": "When", "widget": "rule" },
        { "prop": "setField", "label": "Set field", "widget": "select", "source": "fields" },
        { "prop": "toValue", "label": "To value", "widget": "text" }
      ]
    }
  ]
}
