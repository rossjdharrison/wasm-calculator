{
  "$schema": "../../data.schema.json",
  "id": "cargo-configurator",
  "version": "1.0.0",
  "currency": "EUR",
  "configures": "CargoPolicy",
  "types": {
    "InsurancePolicy": { "specializes": ["class_of_physical_object"], "title": "Insurance" },
    "CargoPolicy": { "specializes": ["InsurancePolicy"], "title": "Cargo insurance" },
    "CargoPremium": { "specializes": ["amount_of_money"] },
    "InsuredValue": { "specializes": ["amount_of_money"] }
  },
  "fields": [
    { "id": "coverType", "type": "choice", "default": "allRisks", "options": [
      { "id": "allRisks" },
      { "id": "namedPerils" },
      { "id": "totalLoss" }
    ] },
    { "id": "shipmentValue", "type": "number", "default": 50000, "min": 0, "step": 1000, "category": "InsuredValue" },
    { "id": "transport", "type": "choice", "default": "sea", "options": [
      { "id": "sea" },
      { "id": "air" },
      { "id": "road" },
      { "id": "rail" }
    ] },
    { "id": "region", "type": "choice", "default": "europe", "options": [
      { "id": "domestic" },
      { "id": "europe" },
      { "id": "intercontinental" },
      { "id": "highRisk" }
    ] }
  ],
  "tables": {
    "coverRate": { "kind": "1d", "map": { "allRisks": 0.006, "namedPerils": 0.004, "totalLoss": 0.0025 } },
    "modeFactor": { "kind": "1d", "map": { "sea": 1.0, "air": 0.8, "road": 1.15, "rail": 0.95 } },
    "regionFactor": { "kind": "1d", "map": { "domestic": 0.8, "europe": 1.0, "intercontinental": 1.3, "highRisk": 1.9 } }
  },
  "computed": [
    { "id": "baseRate", "label": "Cover basis rate", "formula": { "op": "lookup", "args": ["coverRate", { "op": "field", "args": ["coverType"] }] } },
    { "id": "modeAdj", "label": "Transport factor", "formula": { "op": "lookup", "args": ["modeFactor", { "op": "field", "args": ["transport"] }] } },
    { "id": "regionAdj", "label": "Route factor", "formula": { "op": "lookup", "args": ["regionFactor", { "op": "field", "args": ["region"] }] } },
    { "id": "effRate", "label": "Rate on value", "formula": { "op": "mul", "args": [{ "op": "mul", "args": [{ "op": "field", "args": ["baseRate"] }, { "op": "mul", "args": [{ "op": "field", "args": ["modeAdj"] }, { "op": "field", "args": ["regionAdj"] }] }] }, 100] } },
    { "id": "grossPremium", "label": "Gross premium", "category": "CargoPremium", "formula": { "op": "mul", "args": [
      { "op": "field", "args": ["shipmentValue"] },
      { "op": "mul", "args": [{ "op": "field", "args": ["baseRate"] }, { "op": "mul", "args": [{ "op": "field", "args": ["modeAdj"] }, { "op": "field", "args": ["regionAdj"] }] }] }
    ] } },
    { "id": "premium", "label": "Cargo premium", "category": "CargoPremium", "formula": { "op": "max", "args": [75, { "op": "field", "args": ["grossPremium"] }] } }
  ],
  "validations": [
    { "id": "highrisk_note", "field": "region", "severity": "info",
      "message": "High-risk routes may need a war & strikes clause and a pre-shipment survey.",
      "when": { "op": "eq", "args": [{ "op": "field", "args": ["region"] }, "highRisk"] } },
    { "id": "totalloss_note", "field": "coverType", "severity": "info",
      "message": "Total-loss-only covers the whole consignment lost — not partial damage. Consider All risks for fragile goods.",
      "when": { "op": "eq", "args": [{ "op": "field", "args": ["coverType"] }, "totalLoss"] } }
  ]
}
