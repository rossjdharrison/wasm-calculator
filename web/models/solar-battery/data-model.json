{
  "$schema": "../../data.schema.json",
  "id": "solar-battery-configurator",
  "version": "1.0.0",
  "currency": "EUR",
  "configures": "BatteryClass",
  "types": {
    "BatteryClass": { "specializes": ["class_of_physical_object"] },
    "UsableCapacity": { "specializes": ["physical_quantity"] },
    "BatteryCost": { "specializes": ["amount_of_money"] }
  },
  "fields": [
    { "id": "capacity", "type": "choice", "default": "c10", "options": [{ "id": "none" }, { "id": "c5" }, { "id": "c10" }, { "id": "c135" }] }
  ],
  "tables": {
    "usableTable": { "kind": "1d", "map": { "none": 0, "c5": 5, "c10": 10, "c135": 13 } },
    "costTable": { "kind": "1d", "map": { "none": 0, "c5": 3500, "c10": 6000, "c135": 8000 } }
  },
  "computed": [
    { "id": "usableKwh", "label": "Usable capacity", "category": "UsableCapacity", "formula": { "op": "lookup", "args": ["usableTable", { "op": "field", "args": ["capacity"] }] } },
    { "id": "batteryCost", "label": "Battery cost", "category": "BatteryCost", "formula": { "op": "lookup", "args": ["costTable", { "op": "field", "args": ["capacity"] }] } }
  ]
}
