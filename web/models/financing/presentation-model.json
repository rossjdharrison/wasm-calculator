    { "id": "residualValue", "label": "Residual value (lease-end)", "visibleWhen": { "op": "eq", "args": [{ "op": "field", "args": ["mode"] }, 2] }, "format": { "type": "currency", "decimals": 0, "currencyCode": "EUR" } },
    { "id": "totalPayable", "label": "Total payable", "role": "subtotal", "format": { "type": "currency", "decimals": 0, "currencyCode": "EUR" } }
  ]
