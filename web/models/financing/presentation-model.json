{
  "name": "Financing",
  "brand": { "mark": "ROWBLAA", "rest": "FINANCE", "descriptor": "Finance", "tagline": "Haarlem" },
  "sections": [{ "id": "terms", "label": "Terms", "order": 1 }],
  "fields": [
    { "id": "loanType", "label": "Loan type", "section": "terms", "width": "full", "options": [
      { "id": "personal", "label": "Personal loan" },
      { "id": "auto", "label": "Auto finance" },
      { "id": "mortgage", "label": "Mortgage" },
      { "id": "business", "label": "Business loan" }
    ] },
    { "id": "price", "label": "Amount", "section": "terms" },
    { "id": "deposit", "label": "Deposit", "section": "terms", "render": "track" },
    { "id": "termMonths", "label": "Term (months)", "section": "terms" },
    { "id": "mode", "label": "Payment mode", "section": "terms" }
  ],
  "outputs": [
    { "id": "monthly", "label": "Monthly payment", "role": "recurring", "format": { "type": "currency", "decimals": 2, "currencyCode": "EUR" } },
