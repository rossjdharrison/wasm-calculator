        {
          "id": "asFound",
          "label": "As found"
        },
        {
          "id": "conserved",
          "label": "Conserved"
        },
        {
          "id": "restored",
          "label": "Restored"
        }
      ]
    },
    {
      "id": "framing",
      "label": "Framing",
      "control": "buttons",
      "section": "s_presentation",
      "width": "full",
      "visibleWhen": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "op": "field",
                "args": [
                  "piece"
                ]
              },
              "impressionistOil"
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "op": "field",
                "args": [
                  "piece"
                ]
              },
              "turnerWatercolour"
            ]
          }
        ]
      },
      "options": [
        {
          "id": "none",
          "label": "Unframed"
        },
        {
          "id": "gallery",
          "label": "Gallery frame"
        },
        {
          "id": "gilt",
          "label": "Gilt frame"
        }
      ]
    },
    {
      "id": "services",
      "label": "Services",
      "control": "buttons",
      "section": "s_services",
      "width": "full",
      "options": [
        {
          "id": "insuranceValuation",
          "label": "Insurance valuation"
        },
        {
          "id": "conditionReport",
          "label": "Condition report"
        },
        {
          "id": "whiteGlove",
          "label": "White-glove delivery"
        },
        {
          "id": "climatePackaging",
          "label": "Climate packaging"
        },
        {
          "id": "installation",
          "label": "Installation"
        },
        {
          "id": "uvGlazing",
          "label": "UV museum glazing"
        }
      ]
    },
    {
      "id": "settlement",
      "label": "Settlement",
      "control": "buttons",
      "section": "s_settlement",
      "width": "full",
      "options": [
        {
          "id": "full",
          "label": "Settle in full"
        },
        {
          "id": "plan6",
          "label": "6 monthly"
        },
        {
          "id": "plan12",
          "label": "12 monthly"
        }
      ]
    }
  ],
  "outputs": [
    {
      "id": "itemPrice",
      "label": "Acquisition",
      "format": {
        "type": "currency",
        "decimals": 0,
        "currencyCode": "GBP"
      }
    },
    {
      "id": "total",
      "label": "Guide price",
      "format": {
        "type": "currency",
        "decimals": 0,
        "currencyCode": "GBP"
      },
      "emphasis": true,
      "compare": "low",
      "compareLabel": "Guide price"
    },
    {
      "id": "monthlyPayment",
      "label": "Instalment",
      "format": {
        "type": "currency",
        "decimals": 0,
        "currencyCode": "GBP"
      },
      "visibleWhen": {
        "op": "not",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "op": "field",
                "args": [
                  "settlement"
                ]
              },
              "full"
            ]
          }
        ]
      }
    },
    {
      "id": "height",
      "label": "Height",
      "format": {
        "type": "unit",
        "unit": "cm",
        "decimals": 0
      },
      "spec": true,
      "compare": "high"
    },
    {
      "id": "width",
      "label": "Width",
      "format": {
        "type": "unit",
        "unit": "cm",
        "decimals": 0
      },
      "spec": true,
      "compare": "high"
    },
    {
      "id": "weight",
      "label": "Weight",
      "format": {
        "type": "unit",
        "unit": "kg",
        "decimals": 0
      },
      "spec": true
    },
    {
      "id": "insuranceValue",
      "label": "Insurance value",
      "format": {
        "type": "currency",
        "decimals": 0,
        "currencyCode": "GBP"
      },
      "spec": true,
      "compare": "high"
    }
  ]
